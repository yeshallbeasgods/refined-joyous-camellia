# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# Base URL of the system under test (Sauce Demo)
BASE_URL=https://www.saucedemo.com

# Sauce Demo login credentials
STANDARD_USER=standard_user
PASSWORD=secret_sauce

# OpenWeather API key - get one free at https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=your_api_key_here
